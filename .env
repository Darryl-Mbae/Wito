# ─── Notification Scripts ──────────────────────────────────────────────────────
# Use these scripts to manage notifications without exposing logic in the UI
# See src/scripts/ for implementation
#
# Examples:
#   npx ts-node src/scripts/notificationsCLI.ts --type=all --template=announcement --title="Hello" --message="World"
#   npx ts-node src/scripts/notificationsCLI.ts --type=seller --userId=USER_ID --template=templateSold --templateName="Flyer" --amount=500
#
# In code:
#   import { NotificationManager } from 'src/scripts/manageNotifications'
#   NotificationManager.broadcastFeature('Feature Name', 'Description')
#   NotificationManager.notifyTemplateSold(userId, templateName, amount)
# ───────────────────────────────────────────────────────────────────────────────